local function isOnlyCoin(item)
    local name = item.Name:lower()

    local looksLikeCoin =
        name:find("coin")
        or name:find("coins")
        or name:find("money")
        or name:find("cash")
        or name:find("moeda")

    local looksLikeGem =
        name:find("gem")
        or name:find("diamond")
        or name:find("diamante")
        or name:find("crystal")
        or name:find("cristal")

    return looksLikeCoin and not looksLikeGem
end

RunService.Heartbeat:Connect(function()
    if autoOnlyCoins and workspace:FindFirstChild("CurrentMap") and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        for _, map in ipairs(workspace.CurrentMap:GetChildren()) do
            if map:FindFirstChild("Coins") then
                for _, coin in ipairs(map.Coins:GetChildren()) do
                    if isOnlyCoin(coin) then
                        firetouchinterest(hrp, coin, 0)
                        firetouchinterest(hrp, coin, 1)
                    end
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if godMode and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LP.Character.HumanoidRootPart
        local hum = LP.Character:FindFirstChild("Humanoid")

        -- cria plataforma invisível
        if not antiLavaPart then
            antiLavaPart = Instance.new("Part")
            antiLavaPart.Size = Vector3.new(6,1,6)
            antiLavaPart.Anchored = true
            antiLavaPart.CanCollide = true
            antiLavaPart.Transparency = 1
            antiLavaPart.Name = "AntiLavaPlatform"
            antiLavaPart.Parent = workspace
        end

        antiLavaPart.Position = hrp.Position - Vector3.new(0,3,0)

        -- mantém vivo
        if hum then
            hum.Health = hum.MaxHealth
            hum.BreakJointsOnDeath = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        end
    else
        if antiLavaPart then
            antiLavaPart:Destroy()
            antiLavaPart = nil
        end
    end
end)
